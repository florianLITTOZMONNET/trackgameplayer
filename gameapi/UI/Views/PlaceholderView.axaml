<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UI.ViewModels"
             x:Class="UI.Views.PlaceholderView"
             x:DataType="vm:PlaceholderViewModel">

    <StackPanel Background="#100c08" Spacing="16"
                HorizontalAlignment="Center" VerticalAlignment="Center">

        <TextBlock Text="{Binding Title, StringFormat='{}{0} — coming soon'}"
                   Foreground="#e0d8d0" FontSize="18" FontWeight="Bold"/>

        <Button Command="{Binding BackCommand}" Content="← Back to selector"
                Background="#3D3938" Foreground="White"/>
    </StackPanel>
</UserControl>