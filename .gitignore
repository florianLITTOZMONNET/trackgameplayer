## A streamlined .gitignore for modern .NET projects

# Local database
my_steam_data.db
my_steam_data.db-shm
my_steam_data.db-wal



# Configuration files (contain secrets)
**/appsettings.json
**/ok2.cs
.env

# JetBrains Rider
.idea/
*.sln.iml
*.DotSettings.user

# Visual Studio
.vs/

# OS files
.DS_Store
Thumbs.db

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
*.snupkg

# Others
~$*
*~
CodeCoverage/

# MSBuild logs
*.binlog

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml
nunit-*.xml
